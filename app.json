{
  "expo": {
    "name": "Glossia",
    "slug": "glossia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Glossia uses the microphone to record your 30-second speech. The recording is analyzed by AI to score your fluency, filler words, and relevance.",
        "NSPhotoLibraryUsageDescription": "Glossia uses your photo library to let you set a profile photo that is visible to your friends.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.larrycherry13.glossia"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#121212"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a28bd1b9-97da-40f2-8a65-51d44ce1e03b"
      }
    }
  }
}
